E000R

E000: 4C
>SCR

>10 REM LES ALLUMETTES (JEU DE NIM) - CLAUDE IA - 2026
>20 DIM R$(5)
>30 PRINT:PRINT "******** LES ALLUMETTES ********"
>40 PRINT "IL Y A 21 ALLUMETTES. CHACUN A SON TOUR"
>50 PRINT "EN PREND 1, 2 OU 3. CELUI QUI PREND LA"
>60 PRINT "DERNIERE A PERDU !"
>70 N=21:V=0
>80 INPUT "VOULEZ-VOUS COMMENCER (O/N)",R$
>90 IF R$="N" THEN 300
>100 REM TOUR DU JOUEUR
>110 GOSUB 500
>120 INPUT "COMBIEN EN PRENEZ-VOUS",P
>130 IF P<1 OR P>3 THEN 160
>140 IF P>N THEN 170
>150 GOTO 200
>160 PRINT "1, 2 OU 3 SEULEMENT.":GOTO 120
>170 PRINT "IL N'EN RESTE QUE ";N;" !":GOTO 120
>200 N=N-P
>210 IF N=0 THEN 400
>300 REM TOUR DE L'ORDINATEUR
>310 GOSUB 500
>320 C=(N-1) MOD 4
>330 IF C=0 THEN C=RND(3)+1
>340 IF C>N THEN C=N
>350 PRINT "J'EN PRENDS ";C;"."
>360 N=N-C
>370 IF N=0 THEN 450
>380 GOTO 100
>400 PRINT:PRINT "VOUS AVEZ PRIS LA DERNIERE : PERDU !"
>410 GOTO 600
>450 PRINT:PRINT "J'AI PRIS LA DERNIERE : VOUS GAGNEZ !"
>460 GOTO 600
>500 REM AFFICHAGE DES ALLUMETTES
>510 PRINT
>520 FOR I=1 TO N:PRINT "*";:NEXT I
>530 PRINT
>540 FOR I=1 TO N:PRINT "I";:NEXT I
>545 PRINT
>550 FOR I=1 TO N:PRINT "I";:NEXT I
>555 PRINT
>560 PRINT "IL RESTE ";N;" ALLUMETTE(S)."
>570 RETURN
>600 PRINT
>610 INPUT "UNE AUTRE PARTIE (O/N)",R$
>620 IF R$="O" THEN 70
>630 PRINT "AU REVOIR !"
>640 END
>RUN

