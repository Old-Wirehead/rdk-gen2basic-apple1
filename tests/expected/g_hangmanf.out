\
E000R

E000: 4C
>SCR

>10 REM HANGMAN - CLAUDE IA - 2026
>20 DIM W$(12),G$(20),U$(30),A$(26),K(12)
>30 A$="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
>40 PRINT:PRINT "*********** HANGMAN ***********"
>50 PRINT "GUESS THE WORD, ONE LETTER AT A TIME."
>60 PRINT "AFTER 7 MISSES, YOU ARE HANGED!"
>70 GOSUB 2000
>80 L=LEN(W$):E=0:U$=""
>90 FOR I=1 TO L:K(I)=0:NEXT I
>100 PRINT:F=0:PRINT "WORD: ";
>110 FOR I=1 TO L
>120 IF K(I) THEN PRINT W$(I,I);" ";
>130 IF K(I)=0 THEN PRINT "- ";
>140 IF K(I)=0 THEN F=F+1
>150 NEXT I:PRINT
>160 IF F=0 THEN 500
>170 GOSUB 600
>180 IF E>6 THEN 550
>190 IF LEN(U$)>0 THEN PRINT "ALREADY TRIED: ";U$
>200 INPUT "A LETTER",G$
>210 IF LEN(G$)#1 THEN 200
>220 FOR J=1 TO 26:IF A$(J,J)=G$ THEN 240:NEXT J
>230 PRINT "TYPE A LETTER FROM A TO Z.":GOTO 200
>240 J=26:NEXT J
>250 IF LEN(U$)=0 THEN 280
>260 FOR J=1 TO LEN(U$):IF U$(J,J)=G$ THEN 275:NEXT J
>270 GOTO 280
>275 J=LEN(U$):NEXT J:PRINT "YOU TRIED THAT LETTER!":GOTO 100
>280 U$(LEN(U$)+1)=G$
>290 H=0:FOR I=1 TO L
>300 IF W$(I,I)=G$ THEN K(I)=1
>310 IF W$(I,I)=G$ THEN H=1
>320 NEXT I
>330 IF H THEN PRINT "GOOD GUESS!"
>340 IF H=0 THEN E=E+1
>350 IF H=0 THEN PRINT "MISSED!"
>360 GOTO 100
>500 PRINT "WELL DONE! THE WORD IS ";W$
>510 PRINT "WITH ";E;" MISS(ES)."
>520 GOTO 900
>550 PRINT "HANGED! THE WORD WAS ";W$
>560 GOTO 900
>600 REM DRAW THE GALLOWS
>610 PRINT
>620 IF E<3 THEN PRINT
>630 IF E>2 THEN PRINT "  +---+"
>640 IF E<2 THEN PRINT
>650 IF E=2 OR E=3 THEN PRINT "  !"
>660 IF E>3 THEN PRINT "  !   O"
>670 IF E<2 THEN PRINT
>680 IF E>1 AND E<5 THEN PRINT "  !"
>690 IF E=5 THEN PRINT "  !   !"
>700 IF E>5 THEN PRINT "  !  /!\"
>710 IF E<2 THEN PRINT
>720 IF E>1 AND E<7 THEN PRINT "  !"
>730 IF E>6 THEN PRINT "  !  / \"
>740 IF E=0 THEN PRINT
>750 IF E>0 THEN PRINT "======"
>760 PRINT "MISSES: ";E;"/7"
>770 RETURN
>900 PRINT
>910 INPUT "PLAY AGAIN (Y/N)",G$
>920 IF G$="Y" THEN 70
>930 PRINT "GOODBYE!"
>940 END
>2000 R=7:GOTO 2010+R*10
>2010 W$="APPLE":RETURN
>2020 W$="KEYBOARD":RETURN
>2030 W$="CASSETTE":RETURN
>2040 W$="SCREEN":RETURN
>2050 W$="WOZNIAK":RETURN
>2060 W$="MEMORY":RETURN
>2070 W$="PROCESSOR":RETURN
>2080 W$="MONITOR":RETURN
>2090 W$="COMPUTER":RETURN
>2100 W$="PROGRAM":RETURN
>2110 W$="CIRCUIT":RETURN
>2120 W$="TRANSISTOR":RETURN
>2130 W$="GARAGE":RETURN
>2140 W$="BYTE":RETURN
>2150 W$="ASSEMBLER":RETURN
>2160 W$="CALIFORNIA":RETURN
>2170 W$="ELECTRON":RETURN
>2180 W$="SOFTWARE":RETURN
>2190 W$="CHARACTER":RETURN
>2200 W$="CLOCK":RETURN
>RUN

