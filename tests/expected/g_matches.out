E000R

E000: 4C
>SCR

>10 REM MATCHES (NIM) - CLAUDE IA - 2026
>20 DIM R$(5)
>30 PRINT:PRINT "*********** MATCHES ***********"
>40 PRINT "THERE ARE 21 MATCHES. IN TURN, EACH"
>50 PRINT "PLAYER TAKES 1, 2 OR 3. WHOEVER TAKES"
>60 PRINT "THE LAST ONE LOSES!"
>70 N=21:V=0
>80 INPUT "DO YOU WANT TO START (Y/N)",R$
>90 IF R$="N" THEN 300
>100 REM PLAYER'S TURN
>110 GOSUB 500
>120 INPUT "HOW MANY DO YOU TAKE",P
>130 IF P<1 OR P>3 THEN 160
>140 IF P>N THEN 170
>150 GOTO 200
>160 PRINT "1, 2 OR 3 ONLY.":GOTO 120
>170 PRINT "ONLY ";N;" LEFT!":GOTO 120
>200 N=N-P
>210 IF N=0 THEN 400
>300 REM COMPUTER'S TURN
>310 GOSUB 500
>320 C=(N-1) MOD 4
>330 IF C=0 THEN C=RND(3)+1
>340 IF C>N THEN C=N
>350 PRINT "I TAKE ";C;"."
>360 N=N-C
>370 IF N=0 THEN 450
>380 GOTO 100
>400 PRINT:PRINT "YOU TOOK THE LAST ONE: YOU LOSE!"
>410 GOTO 600
>450 PRINT:PRINT "I TOOK THE LAST ONE: YOU WIN!"
>460 GOTO 600
>500 REM DRAW THE MATCHES
>510 PRINT
>520 FOR I=1 TO N:PRINT "*";:NEXT I
>530 PRINT
>540 FOR I=1 TO N:PRINT "I";:NEXT I
>545 PRINT
>550 FOR I=1 TO N:PRINT "I";:NEXT I
>555 PRINT
>560 PRINT N;" MATCH(ES) LEFT."
>570 RETURN
>600 PRINT
>610 INPUT "PLAY AGAIN (Y/N)",R$
>620 IF R$="Y" THEN 70
>630 PRINT "GOODBYE!"
>640 END
>RUN

