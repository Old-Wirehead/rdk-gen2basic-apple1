E000R

E000: 4C
>20 POKE (PEEK(5) OR ABS(X2)),D1: PRINT ABS(1<>C1)<=32767<K AND PEEK(1),"431;88,EH3E!DC. I5L"
>30 PRINT "I9LG33191OP;2ACAHM0D.!NMOECBH6H89!","1LFKBAG,,BAN";" :H J26NNL:.H:72D,C9,O8D7 H."
>40 FOR S=V TO 5: FOR M=1 TO K
>50 H2=1000# RND (H1)*(G): REM  1.J42DGCF:N0;B4;1E8CFK: FOR W=1000 TO 32767
>60 IF RND (99) THEN LET F2=(D2)
>70 X=A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A+A
>80 PRINT "AAAAAAAAAAAAAAAAA",1
>90 PRINT "AAAAAAAAAAAAAAAA",1
>LIST
   20 POKE ( PEEK (5) OR ABS (X2)
      ),D1: PRINT ABS (1<>C1)<=32767
      <K AND PEEK (1),"431;88,EH3E!DC
      . I5L"
   30 PRINT "I9LG33191OP;2ACAHM0D.!NM
      OECBH6H89!","1LFKBAG,,BAN"
      ;" :H J26NNL:.H:72D,C9,O8D7 H."
      
   40 FOR S=V TO 5: FOR M=1 TO K
   50 H2=1000# RND (H1)*(G): REM   1.
      J42DGCF:N0;B4;1E8CFK: FOR W=100
      0 TO 32767
   60 IF RND (99) THEN LET F2=(D2)
      
   70 X=A+A+A+A+A+A+A+A+A+A+A+A+
      A+A+A+A+A+A+A+A+A+A+A+A+A+
      A+A+A+A+A
   80 PRINT "AAAAAAAAAAAAAAAAA",
      1
   90 PRINT "AAAAAAAAAAAAAAAA",1
      

>
