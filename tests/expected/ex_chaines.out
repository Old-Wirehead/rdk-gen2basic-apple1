E000R

E000: 4C
>SCR

>10 DIM N$(20),R$(20)
>20 INPUT "YOUR NAME",N$
>30 L=LEN(N$)
>40 PRINT "INITIAL: ";N$(1,1)
>50 PRINT "END: ";N$(L-1)
>60 R$="":FOR I=L TO 1 STEP -1
>70 R$(LEN(R$)+1)=N$(I,I)
>80 NEXT I
>90 PRINT "BACKWARDS: ";R$
>100 IF R$=N$ THEN PRINT "IT'S A PALINDROME!"
>110 END
>RUN
YOUR NAME?5

INITIAL: 5
