\
E000R

E000: 4C
>SCR

>10 REM GUESS A NUMBER FROM 1 TO 100
>20 N=RND(100)+1:C=0
>30 PRINT "I PICKED A NUMBER FROM 1 TO 100."
>40 INPUT "YOUR GUESS",E
>50 C=C+1
>60 IF E<N THEN PRINT "HIGHER!"
>70 IF E>N THEN PRINT "LOWER!"
>80 IF E#N THEN 40
>90 PRINT "WELL DONE, IN ";C;" TRIES."
>100 END
>RUN
